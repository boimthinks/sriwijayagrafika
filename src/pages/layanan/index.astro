---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { getCollection } from 'astro:content';
import { BUSINESS_INFO, MEDIA_COVERAGES, VIDEOS } from '@lib/data';
import { Factory, ShieldCheck, PenTool, CheckCircle, Users, BadgeCheck, Newspaper, ExternalLink } from 'lucide-react';

const services = (await getCollection('layanan', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order
);

const primary = services.filter((s) => s.data.category === 'utama');

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://sriwijayagrafika.com/layanan#items',
  name: 'Layanan Sriwijaya Grafika',
  description:
    'Daftar lengkap layanan advertising dan reklame Sriwijaya Grafika Palembang.',
  numberOfItems: services.length,
  itemListElement: services.map((s, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `/layanan/${s.id}`,
    name: s.data.name,
    description: s.data.description,
  })),
};

const mediaLinks = [
  { label: 'Sriwijaya Post (Tribun Sumsel)', href: MEDIA_COVERAGES.find((c) => c.publisher.includes('Sriwijaya Post'))?.url ?? '#' },
  { label: 'Berita Sumsel', href: MEDIA_COVERAGES.find((c) => c.publisher.includes('Berita'))?.url ?? '#' },
  { label: 'PAL-TV', href: VIDEOS.find((v) => v.id === 'oeo9x8j1yK0')?.url ?? '#' },
  { label: 'WhatsApp Business Official', href: VIDEOS.find((v) => v.id === 'oJ5VBoOWlMw')?.url ?? '#' },
];
---

<Layout
  title="Jasa Advertising Palembang: Huruf Timbul & Neon Box Bergaransi"
  titleSeo="Jasa Advertising Palembang: Huruf Timbul, Neon Box & Reklame Bergaransi 1 Tahun"
  description="Daftar lengkap layanan advertising Palembang: huruf timbul LED, neon box, papan nama toko, rambu K3, billboard, neon flex, pylon totem. Setiap layanan punya halaman detail."
  keywords={[
    'Layanan Advertising Palembang',
    'Harga Huruf Timbul',
    'Neon Box Custom',
    'Papan Nama Toko',
    'Rambu K3',
    'Booth Event',
  ]}
  structuredData={servicesSchema}
>
  <Navbar current="services" />

  <main class="flex-1">
    <section class="bg-gradient-to-br from-[#224da8] to-[#10285a] text-white py-22 md:py-28 lg:py-32">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          Pilih &amp; Rancang Media Promosi Bisnis Anda
        </h1>
        <p class="text-sm sm:text-base text-white/80 max-w-2xl mx-auto leading-relaxed">
          Dari plang nama toko hingga billboard raksasa, rancang perkiraan harga secara transparan. Pemasangan reklame luar ruangan dilindungi garansi 1 tahun resmi.
        </p>
        <a
          href={`https://wa.me/${BUSINESS_INFO.phone1Intl}?text=${encodeURIComponent('Halo Sriwijaya Grafika, saya ingin berkonsultasi mengenai kebutuhan signage/reklame custom.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white text-sm font-bold shadow-md transition-all"
        >
          Hubungi via WhatsApp
        </a>
      </div>
    </section>

    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-800 tracking-tight">Advertising &amp; Reklame</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {primary.map((service) => <ServiceCard service={service} />)}
        </div>
          <div class="mt-10 space-y-2">
            <p class="text-sm text-neutral-600 max-w-7xl leading-relaxed">
              Kategori ini mencakup 9 layanan unggulan untuk storefront, signage outdoor, dan media promosi visual. Produk flagship kami adalah <strong>huruf timbul LED</strong> dengan pilihan bahan stainless, akrilik, atau galvanil — cocok untuk nama toko, brand gedung, hingga instansi pemerintah seperti Gedung Walikota Palembang dan Kejati Sumsel yang telah menggunakan jasa instalasi kami dengan garansi 1 tahun. Selain huruf timbul, kami memproduksi <strong>neon box custom</strong> untuk brand retail dan SPBU Pertamina, <strong>pylon totem</strong> untuk jalan utama, <strong>neon flex</strong> untuk huruf melengkung, <strong>gantry huruf LED</strong> untuk area parkir dan drop zone, <strong>booth event</strong> untuk pameran, <strong>plang toko</strong> untuk kantor dan ruko, serta <strong>rambu K3</strong> standar Kemnaker untuk keselamatan kerja di pabrik dan gudang.
            </p>
            <p class="text-sm text-neutral-500 max-w-7xl leading-relaxed mt-2">
              Semua produk reklame produksi sendiri di workshop Talang Jambe dengan material berkualitas. Setiap instalasi dilindungi garansi 1 tahun penuh — termasuk untuk proyek korporat skala besar.
            </p>
          </div>
        </div>
      </section>

<!-- Section D: Trust & Social Proof -->
    <section class="py-14 md:py-18 bg-neutral-50/50 border-t border-neutral-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="max-w-2xl mx-auto text-center mb-12 space-y-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#ff6634]/10 text-[#ff6634] text-[10px] font-mono font-bold uppercase tracking-widest">
            <CheckCircle className="w-3 h-3" />
            Trust &amp; Social Proof
          </span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-800 tracking-tight">
            Mengapa Ribuan Klien di Palembang Memilih Kami
          </h2>
          <p class="text-sm text-neutral-500 leading-relaxed">
            Bukan klaim kosong. Angka, nama institusi, dan liputan media di bawah ini bisa Anda cek langsung.
          </p>
        </div>

        <!-- Stats band -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-neutral-200 rounded-3xl overflow-hidden border border-neutral-200 shadow-sm mb-12">
          <div class="bg-white p-6 md:p-8 text-center">
            <p class="font-display text-3xl md:text-4xl font-bold text-[#224da8]">2008</p>
            <p class="mt-1 text-[10px] font-mono uppercase tracking-widest text-neutral-400">sejak mulai melayani</p>
          </div>
          <div class="bg-white p-6 md:p-8 text-center">
            <p class="font-display text-3xl md:text-4xl font-bold text-[#224da8]">1.000+</p>
            <p class="mt-1 text-[10px] font-mono uppercase tracking-widest text-neutral-400">klien Palembang &amp; Sumsel</p>
          </div>
          <div class="bg-white p-6 md:p-8 text-center">
            <p class="font-display text-3xl md:text-4xl font-bold text-[#224da8]">100%</p>
            <p class="mt-1 text-[10px] font-mono uppercase tracking-widest text-neutral-400">produksi di workshop sendiri</p>
          </div>
          <div class="bg-white p-6 md:p-8 text-center">
            <p class="font-display text-3xl md:text-4xl font-bold text-[#224da8]">1 Thn</p>
            <p class="mt-1 text-[10px] font-mono uppercase tracking-widest text-neutral-400">garansi resmi instalasi</p>
          </div>
        </div>

        <!-- USP cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          <div class="bg-white rounded-2xl p-6 border border-neutral-100 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#224da8]/25 to-[#224da8]/5 flex items-center justify-center mb-4">
              <Factory className="w-5 h-5 text-[#224da8]" strokeWidth={1.75} />
            </div>
            <h3 class="text-sm font-extrabold text-neutral-800">Produksi Sendiri, Bukan Makloon</h3>
            <p class="text-xs text-neutral-500 leading-relaxed mt-2">
              Semua produk dikerjakan di workshop Talang Jambe: desain, laser cutting, fabrikasi, sampai instalasi satu tangan. Kualitas dan jadwal jadi lebih terkontrol.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-neutral-200 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#ff6634]/25 to-[#ff6634]/5 flex items-center justify-center mb-4">
              <ShieldCheck className="w-5 h-5 text-[#ff6634]" strokeWidth={1.75} />
            </div>
            <h3 class="text-sm font-extrabold text-neutral-800">Garansi 1 Tahun Semua Instalasi</h3>
            <p class="text-xs text-neutral-500 leading-relaxed mt-2">
              Setiap instalasi huruf timbul, neon box, dan reklame outdoor bergaransi 1 tahun penuh, termasuk proyek Gedung Walikota Palembang dan Kejati Sumsel.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-neutral-200 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500/25 to-emerald-500/5 flex items-center justify-center mb-4">
              <PenTool className="w-5 h-5 text-emerald-600" strokeWidth={1.75} />
            </div>
            <h3 class="text-sm font-extrabold text-neutral-800">Konsultasi Gratis + Mockup 3D</h3>
            <p class="text-xs text-neutral-500 leading-relaxed mt-2">
              Desain cuma-cuma sampai preview mockup 3D sebelum produksi. Anda melihat hasilnya dulu, baru memutuskan, dengan respon WhatsApp yang cepat.
            </p>
          </div>
        </div>

        <!-- Dipercaya oleh -->
        <div class="space-y-4">
          <p class="text-center text-[10px] font-mono font-bold uppercase tracking-widest text-neutral-400">
            <Users className="inline w-3.5 h-3.5 -mt-0.5 mr-1" /> Dipercaya oleh
          </p>
          <div class="flex flex-wrap justify-center gap-2.5">
            {[
              'Gedung Walikota Palembang',
              'Kejati Sumsel',
              'SPBU Pertamina',
              'Super Indo',
              'DPRD OKI',
              'SMP Islam Bina Insani',
              'Riyadh Regency 3',
            ].map((name) => (
              <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-neutral-200 text-xs font-semibold text-neutral-700 shadow-sm">
                <BadgeCheck className="w-3.5 h-3.5 text-emerald-500" strokeWidth={2} />
                {name}
              </span>
            ))}
            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-gradient-to-br from-[#224da8] to-[#10285a] text-white text-xs font-bold shadow-sm">
              + puluhan brand lokal
            </span>
          </div>
        </div>

        <!-- Liputan media -->
        <div class="mt-10 pt-8 border-t border-neutral-200 flex flex-wrap items-center justify-center gap-3">
          <p class="text-[10px] font-mono font-bold uppercase tracking-widest text-neutral-400 mr-1">
            <Newspaper className="inline w-3.5 h-3.5 -mt-0.5 mr-1" /> Liputan media
          </p>
          {mediaLinks.map((m) => (
            <a
              href={m.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-white border border-neutral-200 text-xs font-bold text-neutral-600 hover:border-[#224da8] hover:text-[#224da8] hover:shadow-sm transition-all"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-[#ff6634]" />
              {m.label}
              <ExternalLink className="w-3 h-3 text-neutral-400" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-12 md:py-16 bg-white border-t border-neutral-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
        <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-800 tracking-tight">
          Tidak Menemukan Layanan yang Anda Cari?
        </h2>
        <p class="text-sm text-neutral-500 max-w-2xl mx-auto leading-relaxed">
          Kami menerima pesanan custom sesuai kebutuhan spesifik bisnis Anda. Konsultasikan kebutuhan Anda langsung dengan tim marketing kami.
        </p>
        <a
          href={`https://wa.me/${BUSINESS_INFO.phone1Intl}?text=${encodeURIComponent('Halo Sriwijaya Grafika, saya ingin berkonsultasi mengenai kebutuhan signage/reklame custom.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white text-sm font-bold shadow-md transition-all"
        >
          Hubungi via WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
