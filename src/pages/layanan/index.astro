---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { getCollection } from 'astro:content';
import { BUSINESS_INFO } from '@lib/data';

const services = (await getCollection('layanan', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order
);

const primary = services.filter((s) => s.data.category === 'utama');
const secondary = services.filter((s) => s.data.category === 'secondary');

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://sriwijayagrafika.com/layanan#items',
  name: 'Layanan Sriwijaya Grafika',
  description:
    'Daftar lengkap layanan advertising, reklame, dan percetakan Sriwijaya Grafika Palembang.',
  numberOfItems: services.length,
  itemListElement: services.map((s, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `/layanan/${s.id}`,
    name: s.data.name,
    description: s.data.description,
  })),
};
---

<Layout
  title="Daftar Layanan Lengkap | Advertising, Reklame & Percetakan Palembang"
  description="Daftar lengkap layanan advertising Palembang: huruf timbul LED, neon box, papan nama toko, rambu K3, billboard, neon flex, hingga percetakan kantor. Setiap layanan punya halaman detail."
  keywords={[
    'Layanan Advertising Palembang',
    'Harga Huruf Timbul',
    'Neon Box Custom',
    'Papan Nama Toko',
    'Rambu K3',
    'Percetakan Kantor',
    'Booth Event',
    'Produk Akrilik',
  ]}
  structuredData={servicesSchema}
>
  <Navbar current="services" />

  <main class="flex-1">
    <section class="bg-gradient-to-br from-[#224da8] to-[#10285a] text-white py-22 md:py-28 lg:py-32">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          Pilih &amp; Rancang Media Promosi Bisnis Anda
        </h1>
        <p class="text-sm sm:text-base text-white/80 max-w-2xl mx-auto leading-relaxed">
          Dari plang nama toko hingga brosur sebaran, rancang perkiraan harga secara transparan. Pemasangan reklame luar ruangan dilindungi garansi 1 tahun resmi.
        </p>
        <a
          href={`https://wa.me/${BUSINESS_INFO.phone1Intl}?text=${encodeURIComponent('Halo Sriwijaya Grafika, saya ingin berkonsultasi mengenai kebutuhan signage/reklame/percetakan custom.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white text-sm font-bold shadow-md transition-all"
        >
          Konsultasi via WhatsApp
        </a>
      </div>
    </section>

    <section class="sticky top-20 z-30 bg-white/95 backdrop-blur-md border-b border-neutral-100 shadow-sm" id="layanan-filter-bar">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
          <div class="flex bg-neutral-100 p-1 rounded-xl w-full md:w-auto overflow-x-auto scrollbar-none" role="tablist" aria-label="Filter kategori layanan">
            <button
              type="button"
              data-filter="all"
              role="tab"
              aria-selected="true"
              class="filter-btn flex-1 md:flex-initial px-4 md:px-5 py-2.5 rounded-lg text-xs font-bold transition-all duration-200 bg-white text-[#224da8] shadow-sm whitespace-nowrap"
            >
              Semua
            </button>
            <button
              type="button"
              data-filter="utama"
              role="tab"
              aria-selected="false"
              class="filter-btn flex-1 md:flex-initial px-4 md:px-5 py-2.5 rounded-lg text-xs font-bold transition-all duration-200 text-neutral-500 hover:text-neutral-800 whitespace-nowrap"
            >
              Advertising &amp; Reklame
            </button>
            <button
              type="button"
              data-filter="secondary"
              role="tab"
              aria-selected="false"
              class="filter-btn flex-1 md:flex-initial px-4 md:px-5 py-2.5 rounded-lg text-xs font-bold transition-all duration-200 text-neutral-500 hover:text-neutral-800 whitespace-nowrap"
            >
              Percetakan &amp; Penunjang
            </button>
          </div>

          <div class="hidden md:flex items-center gap-2 text-[11px] text-neutral-500">
            <span class="font-mono font-bold">Tampil:</span>
            <span id="filter-count" class="font-extrabold text-[#224da8]">{services.length}</span>
            <span>dari {services.length} layanan</span>
          </div>
        </div>
      </div>
    </section>

    {primary.length > 0 && (
      <section id="layanan-utama" data-section="utama" class="py-12 md:py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-8 space-y-2">
            <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-800 tracking-tight">Advertising &amp; Reklame</h2>
            <p class="text-sm text-neutral-500 max-w-2xl">
              Produk unggulan signage 3D, papan reklame, dan media promosi luar ruang untuk meningkatkan visibilitas bisnis Anda.
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-section-grid="utama">
            {primary.map((service) => <ServiceCard service={service} />)}
          </div>
        </div>
      </section>
    )}

    {secondary.length > 0 && (
      <section id="layanan-secondary" data-section="secondary" class="py-12 md:py-16 bg-neutral-50/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-8 space-y-2">
            <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-800 tracking-tight">Percetakan &amp; Penunjang</h2>
            <p class="text-sm text-neutral-500 max-w-2xl">
              Percetakan kantor, digital printing, souvenir, dan alat peraga untuk kebutuhan operasional dan promosi massal.
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-section-grid="secondary">
            {secondary.map((service) => <ServiceCard service={service} />)}
          </div>
        </div>
      </section>
    )}

    <div id="layanan-empty" class="hidden bg-white py-16 border-t border-neutral-100">
      <div class="max-w-md mx-auto px-4 text-center space-y-3">
        <p class="text-sm font-bold text-neutral-700">Tidak ada layanan di kategori ini.</p>
        <button type="button" data-filter="all" class="filter-btn inline-flex items-center gap-1.5 text-xs font-bold text-[#224da8] hover:underline">
          Tampilkan semua layanan
        </button>
      </div>
    </div>

    <section class="py-12 md:py-16 bg-white border-t border-neutral-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
        <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-800 tracking-tight">
          Tidak Menemukan Layanan yang Anda Cari?
        </h2>
        <p class="text-sm text-neutral-500 max-w-2xl mx-auto leading-relaxed">
          Kami menerima pesanan custom sesuai kebutuhan spesifik bisnis Anda. Konsultasikan kebutuhan Anda langsung dengan tim marketing kami.
        </p>
        <a
          href={`https://wa.me/${BUSINESS_INFO.phone1Intl}?text=${encodeURIComponent('Halo Sriwijaya Grafika, saya ingin berkonsultasi mengenai kebutuhan signage/reklame/percetakan custom.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white text-sm font-bold shadow-md transition-all"
        >
          Konsultasi via WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const sections = document.querySelectorAll<HTMLElement>('[data-section]');
  const emptyState = document.getElementById('layanan-empty');
  const counter = document.getElementById('filter-count');

  const applyFilter = (filter: string) => {
    let visibleCount = 0;

    sections.forEach((section) => {
      const sectionCategory = section.dataset.section;
      const isVisible = filter === 'all' || sectionCategory === filter;
      section.classList.toggle('hidden', !isVisible);
      if (isVisible) {
        const grid = section.querySelector<HTMLElement>('[data-section-grid]');
        const count = grid?.children.length ?? 0;
        visibleCount += count;
      }
    });

    buttons.forEach((btn) => {
      const isActive = btn.dataset.filter === filter;
      btn.setAttribute('aria-selected', String(isActive));
      btn.classList.toggle('bg-white', isActive);
      btn.classList.toggle('text-[#224da8]', isActive);
      btn.classList.toggle('shadow-sm', isActive);
      btn.classList.toggle('text-neutral-500', !isActive);
      btn.classList.toggle('hover:text-neutral-800', !isActive);
    });

    if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);
    if (counter) counter.textContent = String(visibleCount);
  };

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';
      applyFilter(filter);
    });
  });
</script>
