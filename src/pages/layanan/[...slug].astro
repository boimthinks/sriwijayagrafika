---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { BUSINESS_INFO } from '@lib/data';
import { Calculator, Phone, Check, ArrowLeft, MessageCircle, Package } from 'lucide-react';

export async function getStaticPaths() {
  const services = await getCollection('layanan', ({ data }) => data.published);
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: CollectionEntry<'layanan'>;
}

const { service } = Astro.props;
const { Content } = await render(service);
const data = service.data;

const allServices = (await getCollection('layanan', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order
);
const relatedServices = allServices
  .filter((s) => s.id !== service.id && (s.data.subcategory === data.subcategory || s.data.category === data.category))
  .slice(0, 3);

const waMessage = `Halo Sriwijaya Grafika, saya tertarik dengan layanan *${data.name}* (${data.subcategory}).\n\nMohon informasi ketersediaan, opsi bahan, dan estimasi harga. Terima kasih!`;
const waUrl = `https://wa.me/${BUSINESS_INFO.phone1Intl}?text=${encodeURIComponent(waMessage)}`;

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://sriwijayagrafika.co.id').toString();

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': pageUrl + '#service',
  name: data.name,
  description: data.description,
  serviceType: data.subcategory,
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://sriwijayagrafika.co.id/#business',
    name: BUSINESS_INFO.name,
  },
  areaServed: { '@type': 'City', name: 'Palembang' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    price: data.basePrice,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: data.basePrice,
      priceCurrency: 'IDR',
      referenceUnit: data.priceUnit,
    },
  },
};
---

<Layout
  title={`${data.name} | Sriwijaya Grafika Palembang`}
  description={data.description}
  keywords={[data.name, data.subcategory, 'Advertising Palembang', 'Sriwijaya Grafika']}
  structuredData={serviceSchema}
>
  <Navbar current="services" />

  <main class="flex-1">
    <section class="bg-gradient-to-br from-[#224da8] to-[#10285a] text-white py-10 md:py-14">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <a
          href="/layanan"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-white/70 hover:text-white mb-6 transition-colors"
        >
          <ArrowLeft className="w-3.5 h-3.5" />
          <span>Kembali ke Daftar Layanan</span>
        </a>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          <div class="lg:col-span-2 space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-1 text-[10px] font-bold font-mono uppercase tracking-wide bg-white/10 backdrop-blur rounded-md">
                {data.subcategory}
              </span>
            </div>
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
              {data.name}
            </h1>
            <p class="text-sm md:text-base text-white/80 leading-relaxed max-w-2xl">
              {data.description}
            </p>
            <div class="flex flex-wrap gap-3 pt-2">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white text-sm font-bold shadow-md transition-all"
              >
                <MessageCircle className="w-4 h-4" />
                <span>Tanya via WhatsApp</span>
              </a>
            </div>
          </div>

          <aside class="bg-white text-neutral-800 rounded-3xl p-5 md:p-6 shadow-xl border border-neutral-100 space-y-5">
            <div>
              <span class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 font-mono">Harga Mulai Dari</span>
              <div class="mt-1 flex items-baseline gap-1">
                <span class="text-2xl md:text-3xl font-extrabold text-[#224da8] font-mono">
                  Rp {data.basePrice.toLocaleString('id-ID')}
                </span>
              </div>
              <span class="text-xs text-neutral-500">per {data.priceUnit}</span>
            </div>

            {data.materials && data.materials.length > 0 && (
              <div class="pt-4 border-t border-dashed border-neutral-100">
                <span class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 font-mono mb-2">Material Utama</span>
                <ul class="space-y-1.5 text-xs text-neutral-600">
                  {data.materials.slice(0, 4).map((mat) => (
                    <li class="flex items-start gap-1.5">
                      <Package className="w-3.5 h-3.5 text-[#ff6634] flex-shrink-0 mt-0.5" />
                      <span>{mat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="pt-4 border-t border-dashed border-neutral-100 space-y-2 text-xs text-neutral-500">
              <div class="flex items-center gap-2">
                <Check className="w-3.5 h-3.5 text-emerald-500" />
                <span>Garansi 1 tahun (reklame luar)</span>
              </div>
              <div class="flex items-center gap-2">
                <Check className="w-3.5 h-3.5 text-emerald-500" />
                <span>Konsultasi desain gratis</span>
              </div>
              <div class="flex items-center gap-2">
                <Check className="w-3.5 h-3.5 text-emerald-500" />
                <span>Pemasangan area Palembang</span>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section id="konten" class="py-12 md:py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <article class="prose-article max-w-none">
          <Content />
        </article>

        <div class="mt-12 pt-8 border-t border-neutral-100 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-extrabold text-neutral-800">Tertarik dengan layanan ini?</h3>
            <p class="text-xs text-neutral-500 mt-1">Konsultasikan kebutuhan spesifik Anda dengan tim marketing kami.</p>
          </div>
          <div class="flex gap-2">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white text-sm font-bold shadow-md transition-all"
            >
              <Phone className="w-4 h-4" />
              <span>WhatsApp Admin</span>
            </a>
            <a
              href="/layanan"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white border border-neutral-200 hover:bg-neutral-50 text-neutral-700 text-sm font-bold transition-all"
            >
              Lihat Layanan Lain
            </a>
          </div>
        </div>
      </div>
    </section>

    {relatedServices.length > 0 && (
      <section class="py-12 md:py-16 bg-neutral-50/50 border-t border-neutral-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-8 space-y-2">
            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#ff6634]">Layanan Terkait</span>
            <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-800 tracking-tight">Anda Mungkin Juga Membutuhkan</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedServices.map((s) => <ServiceCard service={s} />)}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
