---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { Phone, MapPin, Clock, MessageCircle, Send, Instagram, Facebook, ShoppingBag, Globe, ArrowRight, ExternalLink, ShieldCheck } from 'lucide-react';
import { BUSINESS_INFO } from '@lib/data';

const waUrl = `https://wa.me/${BUSINESS_INFO.phone1Intl}`;

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Hubungi Sriwijaya Grafika',
  description: 'Kontak Sriwijaya Grafika Palembang untuk konsultasi gratis, estimasi harga, dan mockup 3D sebelum produksi.',
  url: `${Astro.site}/kontak`,
  mainEntity: {
    '@type': 'LocalBusiness',
    name: BUSINESS_INFO.name,
    telephone: [`+62${BUSINESS_INFO.phone1}`],
    email: 'sriwijayagrafika@gmail.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Jl. AMD Jl. Pertanian No.105, RT.029/RW.005, Talang Jambe',
      addressLocality: 'Kota Palembang',
      addressRegion: 'Sumatera Selatan',
      postalCode: '30155',
      addressCountry: 'ID',
    },
    openingHoursSpecification: [
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '17:00' },
      { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '14:00' },
    ],
  },
};
---

<Layout
  title="Hubungi Kami | Sriwijaya Grafika Palembang"
  description="Hubungi Sriwijaya Grafika Palembang untuk konsultasi gratis, estimasi harga, dan mockup 3D. WA 0852-1511-1125. Workshop di Talang Jambe, Sukarami."
  keywords={['Kontak Sriwijaya Grafika', 'Alamat Workshop Palembang', 'Konsultasi Advertising Palembang', 'WhatsApp Sriwijaya Grafika', 'Hubungi Advertising Palembang']}
  structuredData={contactSchema}
>
  <Navbar current="contact" />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-[#224da8] via-[#1a3d8f] to-[#10285a] text-white">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#ff6634]/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
        <div class="absolute bottom-0 left-0 w-72 h-72 bg-[#ff6634]/5 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/10 text-xs font-medium text-white/80 mb-6">
            <Send className="w-3.5 h-3.5" />
            <span>Konsultasi Gratis, Tanpa Komitmen</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.1] mb-4">
            Hubungi <span class="text-[#ff6634]">Kami</span>
          </h1>
          <p class="text-lg md:text-xl text-white/80 leading-relaxed max-w-xl">
            Siap bantu wujudkan media promosi impian Anda. Respon cepat, konsultasi gratis, dan mockup 3D tanpa biaya.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Cards Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- WhatsApp -->
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="group bg-white rounded-2xl p-6 shadow-lg border border-neutral-100 hover:shadow-xl hover:border-[#25d366]/30 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-[#25d366]/10 text-[#25d366] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <MessageCircle className="w-6 h-6" />
          </div>
          <h3 class="font-bold text-neutral-800 text-sm mb-1"> WhatsApp</h3>
          <p class="text-2xl font-extrabold text-neutral-900 font-mono tracking-tight">0852-1511-1125</p>
          <p class="text-xs text-neutral-400 mt-2 flex items-center gap-1 group-hover:text-[#25d366] transition-colors">
            <span>Klik untuk chat</span>
            <ExternalLink className="w-3 h-3" />
          </p>
        </a>

        <!-- Address -->
        <div class="bg-white rounded-2xl p-6 shadow-lg border border-neutral-100">
          <div class="w-12 h-12 rounded-xl bg-[#224da8]/10 text-[#224da8] flex items-center justify-center mb-4">
            <MapPin className="w-6 h-6" />
          </div>
          <h3 class="font-bold text-neutral-800 text-sm mb-1"> Alamat Workshop</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">{BUSINESS_INFO.address}</p>
          <a href={BUSINESS_INFO.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-[#224da8] font-bold mt-3 flex items-center gap-1 hover:underline">
            <span>Petunjuk Google Maps</span>
            <ArrowRight className="w-3 h-3" />
          </a>
        </div>

        <!-- Social Media Hub -->
        <div class="bg-white rounded-2xl p-6 shadow-lg border border-neutral-100">
          <div class="w-12 h-12 rounded-xl bg-[#ff6634]/10 text-[#ff6634] flex items-center justify-center mb-4">
            <Globe className="w-6 h-6" />
          </div>
          <h3 class="font-bold text-neutral-800 text-sm mb-1"> Media Sosial</h3>
          <p class="text-sm text-neutral-600 leading-relaxed mb-3">Ikuti kami untuk update proyek terbaru.</p>
          <div class="flex items-center gap-2.5">
            <a href={BUSINESS_INFO.socials.instagram} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-neutral-100 hover:bg-pink-100 hover:text-pink-600 transition-all text-neutral-500" title="Instagram" aria-label="Instagram">
              <Instagram className="w-4 h-4" />
            </a>
            <a href={BUSINESS_INFO.socials.facebookUtama} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-neutral-100 hover:bg-blue-100 hover:text-blue-600 transition-all text-neutral-500" title="Facebook" aria-label="Facebook">
              <Facebook className="w-4 h-4" />
            </a>
            <a href={BUSINESS_INFO.socials.tiktok} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-neutral-100 hover:bg-neutral-800 hover:text-white transition-all text-neutral-500" title="TikTok" aria-label="TikTok">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.02 1.59 4.23.95 1.2 2.27 2 3.76 2.37v3.59c-1.75-.17-3.41-.88-4.75-2.02-.13-.11-.27-.23-.42-.36-.02.1-.04.18-.04.26v6.94c.03 2.14-1 4.19-2.78 5.37-1.78 1.18-4.08 1.41-6.07.61-2-1-3.39-2.95-3.69-5.18-.3-2.22.68-4.43 2.5-5.69 1.83-1.26 4.28-1.42 6.27-.41v3.54c-.95-.49-2.09-.54-3.08-.13-.99.41-1.72 1.25-1.97 2.29-.25 1.04-.02 2.15.62 3 .64.85 1.63 1.39 2.7 1.45 1.07.06 2.12-.34 2.82-1.15.7-.8 1-1.89.97-2.97V.02z" />
              </svg>
            </a>
            <a href={BUSINESS_INFO.socials.shopee} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-neutral-100 hover:bg-orange-100 hover:text-orange-600 transition-all text-neutral-500" title="Shopee" aria-label="Shopee">
              <ShoppingBag className="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Two Column: Business Hours + Quick Info -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
        <!-- Business Hours -->
        <div class="lg:col-span-2 bg-white rounded-2xl p-8 shadow-lg border border-neutral-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <Clock className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-extrabold text-neutral-800">Jam Operasional</h2>
          </div>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between items-center py-2 border-b border-neutral-100">
              <span class="text-neutral-600">Senin - Jumat</span>
              <span class="font-semibold text-neutral-800">08:00 - 17:00</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-neutral-100">
              <span class="text-neutral-600">Sabtu</span>
              <span class="font-semibold text-neutral-800">08:00 - 14:00</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-neutral-400">Minggu / Hari Besar</span>
              <span class="font-semibold text-neutral-400">Libur</span>
            </div>
          </div>
          <p class="text-xs text-neutral-400 mt-6 leading-relaxed">
            Konsultasi via WhatsApp tetap kami terima di luar jam operasional. Tim kami akan merespon pada jam kerja berikutnya.
          </p>
        </div>

        <!-- Quick Info -->
        <div class="lg:col-span-3 bg-white rounded-2xl p-8 shadow-lg border border-neutral-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-[#224da8]/10 text-[#224da8] flex items-center justify-center">
              <ShieldCheck className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-extrabold text-neutral-800">Mengapa Menghubungi Kami?</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex items-start gap-3 p-4 rounded-xl bg-neutral-50">
              <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                <span class="text-xs font-extrabold">1</span>
              </div>
              <div>
                <h4 class="font-bold text-sm text-neutral-800">Konsultasi Gratis</h4>
                <p class="text-xs text-neutral-500 mt-0.5">Diskusikan kebutuhan signage tanpa biaya, tanpa komitmen.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 rounded-xl bg-neutral-50">
              <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                <span class="text-xs font-extrabold">2</span>
              </div>
              <div>
                <h4 class="font-bold text-sm text-neutral-800">Mockup 3D</h4>
                <p class="text-xs text-neutral-500 mt-0.5">Lihat desain Anda dalam bentuk 3D sebelum produksi.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 rounded-xl bg-neutral-50">
              <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                <span class="text-xs font-extrabold">3</span>
              </div>
              <div>
                <h4 class="font-bold text-sm text-neutral-800">Garansi 1 Tahun</h4>
                <p class="text-xs text-neutral-500 mt-0.5">Semua instalasi signage dilindungi garansi penuh.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 rounded-xl bg-neutral-50">
              <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                <span class="text-xs font-extrabold">4</span>
              </div>
              <div>
                <h4 class="font-bold text-sm text-neutral-800">Respon Cepat</h4>
                <p class="text-xs text-neutral-500 mt-0.5">Tim kami merespon pesan dengan cepat dan personal.</p>
              </div>
            </div>
          </div>
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#25d366] hover:bg-[#1da851] text-white font-semibold text-sm transition-all shadow-md">
            <MessageCircle className="w-4 h-4" />
            <span>Chat WhatsApp Sekarang</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Google Maps -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="rounded-2xl overflow-hidden shadow-lg border border-neutral-100">
        <div class="relative">
          <iframe
            title="Peta Workshop Sriwijaya Grafika"
            src={BUSINESS_INFO.googleMapsEmbed}
            class="w-full h-[420px] md:h-[480px] border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-4 p-3 rounded-xl bg-white/95 backdrop-blur-md border border-neutral-200 shadow-lg">
            <div class="flex items-center gap-2.5 min-w-0">
              <MapPin className="w-5 h-5 text-[#ff6634] flex-shrink-0" />
              <div class="min-w-0">
                <p class="text-xs font-bold text-neutral-800 truncate">Workshop Sriwijaya Grafika</p>
                <p class="text-[10px] text-neutral-500 truncate">Talang Jambe, Kec. Sukarami, Palembang</p>
              </div>
            </div>
            <a
              href={BUSINESS_INFO.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#224da8] hover:bg-[#183c84] text-white text-xs font-semibold transition-colors"
            >
              <ExternalLink className="w-3.5 h-3.5" />
              <span>Buka Maps</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-r from-[#224da8] to-[#10285a] text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4">
            Siap Mulai Proyek <span class="text-[#ff6634]">Signage</span> Anda?
          </h2>
          <p class="text-lg text-white/80 max-w-2xl mx-auto mb-8">
            Tim teknis kami siap survey lokasi gratis di area Palembang dan Sumatera Selatan. Konsultasi dulu, tanpa biaya.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-[#25d366] hover:bg-[#1da851] text-white font-bold text-sm transition-all shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
            >
              <MessageCircle className="w-5 h-5" />
              <span>Chat via WhatsApp</span>
            </a>
            <a
              href="tel:+6285215111125"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-all border border-white/20"
            >
              <Phone className="w-5 h-5" />
              <span>Telpon 0852-1511-1125</span>
            </a>
          </div>
          <p class="text-xs text-white/50 mt-6">
            Respon cepat, konsultasi gratis, mockup 3D, dan garansi 1 tahun untuk setiap instalasi.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
