---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';

const cuttingEntries = await getCollection('cutting', (entry) => entry.data.published !== false);
const cuttingArticles = cuttingEntries.filter((e) => e.data.tipe === 'artikel');
const cuttingDaerah = cuttingEntries.filter((e) => e.data.tipe === 'daerah');
---

<Layout
  title="Sitemap | Sriwijaya Grafika Palembang"
  description="Daftar lengkap halaman dan tautan penting Sriwijaya Grafika Palembang."
  noindex={true}
>
  <Navbar current="home" />

  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-extrabold text-neutral-800 mb-2">Sitemap</h1>
    <p class="text-sm text-neutral-500 mb-8">Halaman-halaman utama Sriwijaya Grafika Palembang.</p>

    <ul class="space-y-3 text-sm">
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/">/ &mdash; Beranda</a>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/layanan/">/layanan/ &mdash; Layanan</a>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/cutting-plat/">/cutting-plat/ &mdash; Workshop Cutting Plat &amp; Laser CNC</a>
        <ul class="ml-4 mt-1.5 space-y-1 text-xs text-neutral-600">
          <li>
            <a class="text-[#224da8] font-medium hover:underline" href="/cutting-plat/artikel/">/cutting-plat/artikel/ &mdash; Kumpulan Artikel &amp; Panduan Cutting</a>
          </li>
          {cuttingArticles.length > 0 && (
            <li class="pt-1">
              <span class="font-semibold text-neutral-700">Artikel &amp; Panduan Spesialisasi:</span>
              <ul class="ml-3 mt-0.5 space-y-0.5 text-neutral-500">
                {cuttingArticles.map((art) => (
                  <li>
                    <a class="hover:underline hover:text-[#224da8]" href={`/cutting-plat/${art.id}/`}>
                      /cutting-plat/{art.id}/ &mdash; {art.data.titleSeo || art.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          )}
          {cuttingDaerah.length > 0 && (
            <li class="pt-1">
              <span class="font-semibold text-neutral-700">Area Layanan Sumatera Selatan:</span>
              <ul class="ml-3 mt-0.5 space-y-0.5 text-neutral-500">
                {cuttingDaerah.map((d) => (
                  <li>
                    <a class="hover:underline hover:text-[#224da8]" href={`/cutting-plat/${d.id}/`}>
                      /cutting-plat/{d.id}/ &mdash; {d.data.titleSeo || d.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          )}
        </ul>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/portofolio/">/portofolio/ &mdash; Galeri Portofolio</a>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/media/">/media/ &mdash; Liputan Media &amp; Profil</a>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/arsip/">/arsip/ &mdash; Arsip Artikel</a>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/kontak/">/kontak/ &mdash; Kontak</a>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/syarat-ketentuan/">/syarat-ketentuan/ &mdash; Syarat & Ketentuan</a>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/kebijakan-privasi/">/kebijakan-privasi/ &mdash; Kebijakan Privasi</a>
      </li>
      <li>
        <a class="text-[#224da8] font-bold hover:underline" href="/blog/">/blog/ &mdash; Blog</a>
        <ul class="ml-4 mt-1 space-y-0.5 text-xs text-neutral-500">
          <li><a class="hover:underline" href="/blog/tips/">/blog/tips/ &mdash; Tips &amp; Trik</a></li>
          <li><a class="hover:underline" href="/blog/studi-kasus/">/blog/studi-kasus/ &mdash; Studi Kasus</a></li>
          <li><a class="hover:underline" href="/blog/panduan/">/blog/panduan/ &mdash; Panduan</a></li>
          <li><a class="hover:underline" href="/blog/kabar/">/blog/kabar/ &mdash; Kabar</a></li>
        </ul>
      </li>
    </ul>

    <p class="text-xs text-neutral-400 mt-6 font-mono">
      RSS Blog: <a class="text-[#224da8] hover:underline" href="/blog/rss.xml">/blog/rss.xml</a>
    </p>

    <p class="text-xs text-neutral-400 mt-12 font-mono">
      XML Sitemap tersedia di <a class="text-[#224da8] hover:underline" href="/sitemap-index.xml">/sitemap-index.xml</a>
    </p>
  </main>

  <Footer />
</Layout>
