---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import Hero from '@components/Hero.astro';
import Credentials from '@components/Credentials.astro';
import OrderHistory from '@components/OrderHistory';
import ServiceCard from '@components/ServiceCard.astro';
import { ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';
import { BUSINESS_INFO, GENERAL_DESCRIPTION } from '@lib/data';

const allServices = (await getCollection('layanan', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order
);
const primaryFeatured = allServices.filter((s) => s.data.category === 'utama').slice(0, 3);
const totalServices = allServices.length;

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://sriwijayagrafika.co.id/#website',
  name: BUSINESS_INFO.name,
  url: 'https://sriwijayagrafika.co.id',
  description: GENERAL_DESCRIPTION.slice(0, 160),
  inLanguage: 'id-ID',
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://sriwijayagrafika.co.id' },
  ],
};
---

<Layout
  title="Sriwijaya Grafika Palembang | Jasa Huruf Timbul, Neon Box & Reklame Termurah"
  description="Sriwijaya Grafika Palembang - Jasa advertising, huruf timbul LED, neon box, papan nama toko, rambu K3, dan percetakan. Garansi resmi 1 tahun. Hubungi WhatsApp 0851-0088-8748."
  keywords={[
    'Advertising Palembang',
    'Huruf Timbul Palembang',
    'Neon Box Palembang',
    'Papan Nama Toko',
    'Percetakan Palembang',
    'Rambu K3',
    'Reklame Palembang',
    'Sriwijaya Grafika',
  ]}
  structuredData={[homeSchema, breadcrumbs]}
>
  <Navbar current="home" />

  <main class="flex-1">
    <Hero />

    <section class="bg-white py-12 border-y border-neutral-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
          <div class="space-y-1">
            <span class="text-xs uppercase font-mono font-bold text-[#ff6634] tracking-widest block">PILIHAN PRIORITAS KONSUMEN</span>
            <h3 class="text-2xl font-extrabold text-neutral-800 tracking-tight">Layanan Utama &amp; Terlaris</h3>
          </div>
          <a
            href="/layanan"
            class="text-xs font-bold text-[#224da8] inline-flex items-center gap-1 hover:underline"
          >
            <span>Lihat Seluruh Layanan ({totalServices} item)</span>
            <ArrowRight className="w-3 h-3" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {primaryFeatured.map((service) => <ServiceCard service={service} />)}
        </div>
      </div>
    </section>

    <Credentials />

    <OrderHistory client:load />
  </main>

  <Footer />
</Layout>
