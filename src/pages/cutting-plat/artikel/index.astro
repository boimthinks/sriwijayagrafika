---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';
import { BUSINESS_INFO } from '@lib/data';
import { 
  FileText, 
  ArrowRight, 
  Calendar, 
  Clock, 
  MessageCircle, 
  Layers, 
  ArrowLeft,
  Search,
  Sparkles
} from 'lucide-react';

const title = 'Kumpulan Artikel & Panduan Laser Cutting Plat & CNC Router | Sriwijaya Grafika';
const description = 'Pusat edukasi, panduan format file DXF/CDR, tips memilih material plat besi, ACP fasad, akrilik, serta kalkulasi biaya jasa cutting laser presisi.';
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://sriwijayagrafika.com').toString();
const pilarUrl = new URL('/cutting-plat/', Astro.site ?? 'https://sriwijayagrafika.com').toString();

// Ambil seluruh artikel edukasi & spesialisasi cutting (tipe: artikel)
const articles = await getCollection('cutting', ({ data }) => data.published && data.tipe === 'artikel');
const sortedArticles = articles.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const waGeneralMsg = 'Halo Sriwijaya Grafika, saya membaca rubrik artikel cutting plat dan ingin berkonsultasi seputar teknis pemotongan & estimasi biaya.';
const waUrl = `https://wa.me/${BUSINESS_INFO.phone1Intl}?text=${encodeURIComponent(waGeneralMsg)}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#collection`,
    name: title,
    description: description,
    url: pageUrl,
    isPartOf: {
      '@type': 'WebPage',
      url: pilarUrl,
      name: 'Jasa Cutting Plat & Laser CNC Sriwijaya Grafika'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Beranda',
        item: 'https://sriwijayagrafika.com/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Cutting Plat',
        item: pilarUrl
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Artikel & Panduan',
        item: pageUrl
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={pageUrl}
  keywords={[
    'artikel laser cutting',
    'panduan potong plat besi',
    'tips CNC router ACP',
    'format file DXF laser cutting',
    'harga potong plat per meter',
    'bengkel laser cutting Palembang'
  ]}
  structuredData={structuredData}
>
  <Navbar />

  <main class="min-h-screen bg-neutral-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <!-- Breadcrumb Navigasi -->
      <nav class="flex items-center space-x-2 text-xs text-neutral-500 font-mono">
        <a href="/" class="hover:text-[#224da8] transition-colors">Beranda</a>
        <span>/</span>
        <a href="/cutting-plat/" class="hover:text-[#224da8] transition-colors">Cutting Plat</a>
        <span>/</span>
        <span class="text-neutral-800 font-bold">Artikel &amp; Panduan</span>
      </nav>

      <!-- Header Section -->
      <header class="bg-gradient-to-br from-[#10285a] to-[#224da8] rounded-3xl p-8 sm:p-12 text-white shadow-lg space-y-4 relative overflow-hidden">
        <div class="absolute right-0 bottom-0 opacity-10 translate-x-10 translate-y-10 pointer-events-none">
          <FileText className="w-80 h-80 text-white" />
        </div>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-[#ff6634] text-xs font-bold uppercase tracking-wider font-mono">
          <Sparkles className="w-4 h-4 text-[#ff6634]" />
          <span>Rubrik Edukasi &amp; Teknis Fabrikasi</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
          Artikel &amp; Panduan Jasa Cutting Plat
        </h1>

        <p class="text-sm sm:text-base text-white/85 max-w-2xl leading-relaxed">
          Kumpulan referensi teknis, panduan format file DXF/CDR, tips memilih bahan plat besi, ACP fasad, akrilik, serta analisis efisiensi biaya proyek cutting laser presisi di Palembang dan Sumatera Selatan.
        </p>

        <div class="pt-4 flex items-center gap-4">
          <a
            href="/cutting-plat/"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/15 hover:bg-white/20 text-white text-xs font-bold border border-white/20 transition-colors"
          >
            <ArrowLeft className="w-4 h-4" />
            <span>Kembali ke Halaman Utama Cutting</span>
          </a>
        </div>
      </header>

      <!-- Grid Daftar Artikel -->
      {sortedArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedArticles.map((art) => (
            <article class="bg-white rounded-3xl border border-neutral-200/80 overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group">
              <div>
                <a href={`/cutting-plat/${art.id}/`} class="block relative aspect-[4/3] w-full overflow-hidden bg-neutral-100">
                  <img
                    src={art.data.imgurl || '/img/cutting-plat/mesin-potong-laser-fiber_poco.webp'}
                    alt={art.data.imgalt || art.data.titleSeo || art.data.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute top-3 left-3 flex items-center gap-1.5">
                    <span class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase font-mono bg-neutral-900/80 backdrop-blur-md text-white border border-white/20">
                      {art.data.kategori}
                    </span>
                    {art.data.daerah && (
                      <span class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase font-mono bg-[#ff6634]/90 backdrop-blur-md text-white border border-white/20">
                        {art.data.daerah}
                      </span>
                    )}
                  </div>
                </a>

                <div class="p-6 space-y-3">
                  <div class="flex items-center justify-between text-[11px] text-neutral-400 font-mono">
                    <span class="flex items-center gap-1">
                      <Calendar className="w-3 h-3 text-neutral-400" />
                      <span>{art.data.date}</span>
                    </span>
                  </div>

                  <h2 class="text-base font-extrabold text-neutral-900 group-hover:text-[#224da8] transition-colors leading-snug">
                    <a href={`/cutting-plat/${art.id}/`}>
                      {art.data.titleSeo || art.data.title}
                    </a>
                  </h2>

                  <p class="text-xs text-neutral-600 line-clamp-3 leading-relaxed">
                    {art.data.excerpt || art.data.pengantar}
                  </p>
                </div>
              </div>

              <div class="p-6 pt-0 border-t border-neutral-100 flex items-center justify-between text-xs font-mono">
                <span class="text-neutral-400">Tim Sriwijaya Grafika</span>
                <a
                  href={`/cutting-plat/${art.id}/`}
                  class="font-bold text-[#ff6634] hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
                >
                  <span>Baca Artikel</span>
                  <ArrowRight className="w-3.5 h-3.5" />
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-3xl p-12 text-center border border-neutral-200 space-y-3">
          <p class="text-neutral-600 text-sm">Belum ada artikel teknis yang diterbitkan saat ini.</p>
          <a href="/cutting-plat/" class="inline-block text-xs font-bold text-[#224da8] hover:underline">
            Kembali ke Halaman Cutting Plat
          </a>
        </div>
      )}

      <!-- Bottom Banner Konsultasi File -->
      <section class="bg-white rounded-3xl p-8 border border-neutral-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center sm:text-left">
          <h3 class="text-lg font-extrabold text-neutral-900">
            Punya File Gambar yang Ingin Langsung Dicek?
          </h3>
          <p class="text-xs text-neutral-500 max-w-xl">
            Kirimkan file format DXF, DWG, CDR, atau sketsa tangan via WhatsApp. Tim teknis kami siap memeriksa kelayakan potong tanpa biaya.
          </p>
        </div>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white font-extrabold text-xs shadow-lg shadow-orange-500/20 transition-all"
        >
          <MessageCircle className="w-4 h-4" />
          <span>Konsultasi File WhatsApp</span>
        </a>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
