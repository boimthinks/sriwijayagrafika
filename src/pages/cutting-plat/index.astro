              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200 bg-white">
              <tr class="hover:bg-neutral-50">
                <td class="p-4 font-bold text-neutral-900">Plat Besi Hitam (SPHC/Carbon)</td>
                <td class="p-4">Fiber Laser</td>
                <td class="p-4 font-mono font-bold text-[#ff6634]">16.0 mm</td>
                <td class="p-4 font-mono">&plusmn; 0.1 mm</td>
                <td class="p-4 font-mono">DXF, DWG</td>
                <td class="p-4">Bawa Sendiri / Dari Workshop</td>
              </tr>
              <tr class="hover:bg-neutral-50">
                <td class="p-4 font-bold text-neutral-900">Stainless Steel (201 / 304)</td>
                <td class="p-4">Fiber Laser (N2 Cut)</td>
                <td class="p-4 font-mono font-bold text-[#ff6634]">6.0 mm</td>
                <td class="p-4 font-mono">&plusmn; 0.08 mm</td>
                <td class="p-4 font-mono">DXF, DWG</td>
                <td class="p-4">Bawa Sendiri / Dari Workshop</td>
              </tr>
              <tr class="hover:bg-neutral-50">
                <td class="p-4 font-bold text-neutral-900">Plat Aluminium &amp; Bordes</td>
                <td class="p-4">Fiber Laser / CNC Router</td>
                <td class="p-4 font-mono font-bold text-[#ff6634]">4.0 mm</td>
                <td class="p-4 font-mono">&plusmn; 0.1 mm</td>
                <td class="p-4 font-mono">DXF, DWG</td>
                <td class="p-4">Bawa Sendiri / Dari Workshop</td>
              </tr>
              <tr class="hover:bg-neutral-50">
                <td class="p-4 font-bold text-neutral-900">ACP (Aluminium Composite Panel)</td>
                <td class="p-4">CNC Router Spindle</td>
                <td class="p-4 font-mono font-bold text-[#ff6634]">4.0 mm (Full Sheet)</td>
                <td class="p-4 font-mono">&plusmn; 0.15 mm</td>
                <td class="p-4 font-mono">CDR, DXF, AI</td>
                <td class="p-4">Seven, Marks, Alucobond, dll</td>
              </tr>
              <tr class="hover:bg-neutral-50">
                <td class="p-4 font-bold text-neutral-900">Multiplek, Plywood, MDF, HMR</td>
                <td class="p-4">CNC Router Heavy Duty</td>
                <td class="p-4 font-mono font-bold text-[#ff6634]">18.0 mm</td>
                <td class="p-4 font-mono">&plusmn; 0.2 mm</td>
                <td class="p-4 font-mono">CDR, DXF</td>
                <td class="p-4">Bawa Sendiri / Dari Workshop</td>
              </tr>
              <tr class="hover:bg-neutral-50">
                <td class="p-4 font-bold text-neutral-900">Akrilik Bening / Warna / Susu</td>
                <td class="p-4">Laser CO2 High Speed</td>
                <td class="p-4 font-mono font-bold text-[#ff6634]">20.0 mm</td>
                <td class="p-4 font-mono">&plusmn; 0.05 mm</td>
                <td class="p-4 font-mono">CDR, AI, DXF</td>
                <td class="p-4">Marga Cipta / Astariglas / Lokal</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-xs uppercase font-mono tracking-widest text-[#ff6634] font-bold block mb-2">
          FAQ &bull; PERTANYAAN UMUM
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-neutral-900 tracking-tight">
          Hal yang Kerap Ditanyakan Klien
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, idx) => (
          <div class="p-5 rounded-2xl bg-white border border-neutral-200/80 shadow-sm space-y-2">
            <h3 class="text-sm font-extrabold text-[#224da8] flex items-start gap-2.5">
              <span class="text-[#ff6634] font-mono">0{idx + 1}.</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-xs text-neutral-600 leading-relaxed pl-6">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <section class="bg-gradient-to-r from-[#224da8] to-[#10285a] text-white py-14">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <span class="inline-block px-3 py-1 rounded-full bg-white/10 border border-white/20 text-[#ff6634] text-xs font-bold uppercase tracking-wider font-mono">
          KONSULTASI &bull; ESTIMASI BIAYA &bull; FILE CHECK
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
          Punya Desain atau Gambar Kerja yang Ingin Dipotong?
        </h2>
        <p class="text-sm sm:text-base text-white/80 max-w-2xl mx-auto leading-relaxed">
          Kirimkan file Anda via WhatsApp sekarang. Tim engineering Sriwijaya Grafika siap melakukan review ketebalan bahan, estimasi waktu, dan total biaya tanpa biaya konsultasi.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={waGeneralUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white font-extrabold text-sm shadow-xl shadow-orange-500/20 transition-all transform hover:-translate-y-0.5"
          >
            <MessageCircle className="w-5 h-5" />
            <span>Chat WhatsApp: 0852-1511-1125</span>
          </a>
          <a
            href="#wilayah-sumsel"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/20 transition-all"
          >
            <Truck className="w-4 h-4" />
            <span>Cek Layanan Pengiriman Daerah</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
