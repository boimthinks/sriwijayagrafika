---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { BUSINESS_INFO } from '@lib/data';
import { parseBloggerSlug, bloggerOldPath, bloggerDateLabel, sortBloggerPosts } from '@lib/blogger';
import { Archive, Calendar, MessageCircle, FolderArchive } from 'lucide-react';

type Posts = CollectionEntry<'blogger'>[];

const allPosts = sortBloggerPosts(
  (await getCollection('blogger', ({ data }) => data.published)).filter(
    (post) => post.data.title.trim().length > 0
  )
);

const grouped = allPosts.reduce<Record<string, Posts>>((acc, post) => {
  const year = parseBloggerSlug(post.data.slug)?.year ?? 'Lainnya';
  (acc[year] ??= []).push(post);
  return acc;
}, {});
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));

const waLink = `https://wa.me/${BUSINESS_INFO.phone1Intl}?text=${encodeURIComponent('Halo Sriwijaya Grafika, saya melihat halaman arsip artikel di website Anda dan ingin bertanya.')}`;
---

<Layout
  title="Arsip Artikel | Sriwijaya Grafika Palembang"
  description="Kumpulan artikel arsip dari website lama Sriwijaya Grafika yang dipertahankan agar konten dan tautan lama tetap dapat dibaca."
  keywords={['Arsip Artikel', 'Sriwijaya Grafika', 'Advertising Palembang', 'Blog Lama']}
>
  <Navbar current="home" />

  <main class="flex-1">
    <section class="bg-gradient-to-br from-[#224da8] to-[#10285a] text-white py-20 md:py-28">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-bold font-mono uppercase tracking-wide bg-[#ff6634] text-white rounded-md shadow-md mx-auto">
          <FolderArchive className="w-3 h-3" />
          Arsip Website Lama
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">Arsip Artikel</h1>
        <p class="text-sm md:text-base text-white/80 max-w-2xl mx-auto leading-relaxed">
          Kumpulan artikel lama dari website Sriwijaya Grafika. Kami mempertahankan halaman
          ini agar tautan lama tetap dapat dibaca. Untuk layanan terbaru silakan kunjungi
          halaman <a href="/layanan" class="text-white underline underline-offset-2 hover:text-[#ff6634]">Layanan</a>.
        </p>
      </div>
    </section>

    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        {years.map((year) => (
          <div>
            <div class="flex items-center gap-3 mb-5">
              <h2 class="text-xl md:text-2xl font-extrabold text-neutral-800">{year}</h2>
              <span class="px-2 py-0.5 rounded-full bg-[#224da8]/10 text-[#224da8] text-xs font-bold">
                {grouped[year].length} artikel
              </span>
              <div class="flex-1 h-px bg-neutral-100"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {grouped[year].map((post) => (
                  <a
                    href={bloggerOldPath(post)}
                    class="group flex items-start gap-4 p-4 rounded-2xl border border-neutral-100 bg-white shadow-sm hover:shadow-md hover:border-[#224da8]/20 transition-all duration-300"
                  >
                    <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-[#224da8] to-[#10285a] flex items-center justify-center text-white">
                      <Archive className="w-4 h-4" />
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-sm font-bold text-neutral-800 group-hover:text-[#224da8] transition-colors leading-snug line-clamp-2">
                        {post.data.title}
                      </h3>
                      <p class="mt-1.5 flex items-center gap-1 text-[11px] font-mono text-neutral-500">
                        <Calendar className="w-3 h-3" />
                        {bloggerDateLabel(post.data.date)}
                      </p>
                    </div>
                  </a>
                ))}
            </div>
          </div>
        ))}

        {allPosts.length === 0 && (
          <div class="py-16 text-center">
            <p class="text-sm text-neutral-500">Belum ada arsip artikel.</p>
          </div>
        )}
      </div>
    </section>

    <section class="py-12 md:py-16 bg-neutral-50/50 border-t border-neutral-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
        <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-800 tracking-tight">
          Cari Kebutuhan Terbaru?
        </h2>
        <p class="text-sm text-neutral-500 max-w-2xl mx-auto leading-relaxed">
          Artikel ini hanya arsip. Untuk harga, material, dan penawaran terbaru, tim marketing kami siap membantu via WhatsApp.
        </p>
        <div class="flex flex-wrap justify-center gap-3 pt-2">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#ff6634] hover:bg-[#e4511f] text-white text-sm font-bold shadow-md transition-all"
          >
            <MessageCircle className="w-4 h-4" />
            Hubungi via WhatsApp
          </a>
          <a
            href="/layanan"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white border border-neutral-200 hover:bg-neutral-50 text-neutral-700 text-sm font-bold transition-all"
          >
            Lihat Layanan Terbaru
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>