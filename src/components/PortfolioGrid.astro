---
import type { PortfolioItem, PortfolioCategory } from '@lib/portfolio';

interface Props {
  items: PortfolioItem[];
  categories: PortfolioCategory[];
  whatsappHref: string;
  whatsappDisplay: string;
}

const { items, categories, whatsappHref, whatsappDisplay } = Astro.props;
---

<section class="bg-white" id="portfolio-section">
  <div
    class="sticky top-20 z-30 bg-white/95 backdrop-blur-md border-b border-neutral-100 shadow-sm"
    id="portfolio-filter-bar"
  >
    <div class="max-w-7xl mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-3">
      <div
        class="flex items-center gap-2 overflow-x-auto pb-1 -mx-1 px-1"
        role="tablist"
        aria-label="Filter kategori portofolio"
      >
        <button
          type="button"
          data-filter="all"
          role="tab"
          aria-selected="true"
          class="filter-btn shrink-0 px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 bg-neutral-800 text-white shadow-sm"
        >
          Semua ({items.length})
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            data-filter={cat.id}
            role="tab"
            aria-selected="false"
            class="filter-btn shrink-0 px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 bg-neutral-50 border border-neutral-100 text-neutral-600 hover:bg-neutral-100"
          >
            {cat.label} ({cat.count})
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="lg:max-w-7xl lg:mx-auto lg:px-8 xl:px-10 grid grid-cols-3 gap-0.5 sm:gap-1 lg:gap-1" id="portfolio-grid">
    {items.map((item) => (
      <button
        type="button"
        data-id={item.id}
        data-category={item.category}
        data-image-src={item.src}
        data-caption={item.caption}
        data-category-label={item.categoryLabel}
        onclick="window.__pfOpenLightbox && window.__pfOpenLightbox(this)"
        aria-label={`Lihat detail: ${item.caption}`}
        class="group relative aspect-square overflow-hidden bg-neutral-100 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#ff6634] focus:ring-offset-1"
      >
        <img
          src={item.src}
          alt={item.caption}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-black/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-2 sm:p-3"
        >
          <div class="text-white min-w-0 w-full">
            <span
              class="block text-[8px] sm:text-[9px] font-mono uppercase tracking-widest opacity-90 truncate"
            >
              {item.categoryLabel}
            </span>
            <span
              class="block text-[10px] sm:text-xs font-bold leading-tight line-clamp-2 mt-0.5"
            >
              {item.caption}
            </span>
          </div>
        </div>
      </button>
    ))}
  </div>

  <div id="portfolio-empty" class="hidden bg-white py-16">
    <div class="max-w-md mx-auto px-4 text-center space-y-3">
      <p class="text-sm font-bold text-neutral-700">Belum ada portofolio di kategori ini.</p>
      <button
        type="button"
        data-filter="all"
        class="filter-btn inline-flex items-center gap-1.5 text-xs font-bold text-[#224da8] hover:underline"
      >
        Tampilkan semua kategori
      </button>
    </div>
  </div>
</section>

<dialog
  id="portfolio-lightbox"
  class="fixed inset-0 w-screen h-screen max-w-none max-h-none m-0 p-0 bg-black/95 backdrop:bg-black/80 text-white border-0 open:animate-pfFadeIn"
  aria-label="Pratinjau portofolio"
>
  <button
    type="button"
    onclick="window.__pfCloseLightbox && window.__pfCloseLightbox()"
    class="absolute top-3 right-3 sm:top-4 sm:right-4 z-20 p-2 bg-white/10 hover:bg-white/20 backdrop-blur rounded-full transition-colors"
    aria-label="Tutup pratinjau"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <button
    type="button"
    id="pf-prev"
    class="hidden sm:flex absolute left-3 top-1/2 -translate-y-1/2 z-20 p-2 bg-white/10 hover:bg-white/20 backdrop-blur rounded-full transition-colors"
    aria-label="Sebelumnya"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button
    type="button"
    id="pf-next"
    class="hidden sm:flex absolute right-3 top-1/2 -translate-y-1/2 z-20 p-2 bg-white/10 hover:bg-white/20 backdrop-blur rounded-full transition-colors"
    aria-label="Selanjutnya"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <div class="w-full h-full flex items-center justify-center p-0 sm:p-12">
    <div class="relative max-w-full max-h-full">
      <img
        id="pf-lightbox-img"
        class="max-w-full max-h-full w-auto h-auto object-contain block"
        alt=""
      />
      <div
        class="absolute top-2.5 left-2.5 md:top-5 md:left-5 max-w-[calc(100%-1.25rem)] md:max-w-[calc(100%-2.5rem)] bg-black p-2 md:p-3 rounded-sm pointer-events-none"
      >
        <span
          id="pf-lightbox-category"
          class="block text-[10px] sm:text-xs font-mono uppercase tracking-widest text-[#ff6634]"
        ></span>
        <h3
          id="pf-lightbox-caption"
          class="block text-sm sm:text-base md:text-lg font-extrabold leading-tight text-white mt-0.5"
        ></h3>
      </div>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute bottom-2.5 left-2.5 md:bottom-5 md:left-5 inline-flex items-center gap-2 bg-[#ff6634] text-white px-2.5 py-1.5 md:px-3 md:py-2 rounded-sm z-10 shadow-md transition-colors"
        aria-label="Hubungi Sriwijaya Grafika via WhatsApp"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 1073 935"
          class="w-4 h-4 md:w-5 md:h-5 shrink-0"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            fill="currentColor"
            d="M1040 662c-9.5 17-23.6 40.4-31 47l-.9 149.9c0 42.8-33.5 76.8-76.5 76.8H138c-41.97 0-76-34-76-76.8v-34.6c-5.94-2.4-17.64-7-29-11.4-16.37-6.3-33-15-33-15l58-86-32 72 36 13.7v-.16c46.33 17.74 139.25 46.79 274 57.5 97.43 9.43 279.86 2 421-44 129.95-41.75 227.28-112.36 251.92-131.23 7.04-7.6 20.53-22.58 32.58-38.77 17.4-21.15 31.1-45.85 31.1-45.85s-12 36.91-32 67.89ZM574 746c-203.55 33.92-466.1-85-466.1-85L62 731V450.18c19.63 27.67 75.73 86.36 162 98.83 117.63 16.99 192-2 192-2l261-47s192.29-41.84 237.43 27.85C960.71 597.84 779.44 713.98 574 746Z"
          ></path>
          <path
            fill-rule="evenodd"
            fill="currentColor"
            d="M886 437c-79.91-13.83-188-3-188-3s57.05-20.31 101-47c36.94-22.44 62.05-52 62.05-52L749 242s17.41 74.55-92 118C518.54 415.84 240.15 422.54 219.1 337 178.76 161.93 689 125 689 125S461.19 111.26 259 172c-105.9 33.24-179.53 109.06-197.9 128.36V75c0-41.97 35.03-76 77-76h794c42.97 0 77 34.03 77 76v411.53c-9.85-7.06-55.89-37.92-123-49.53Z"
          ></path>
        </svg>
        <span class="text-[10px] sm:text-xs md:text-sm font-bold tracking-wide whitespace-nowrap">
          {whatsappDisplay}
        </span>
      </a>
    </div>
  </div>
</dialog>

<style>
  #portfolio-lightbox[open] {
    animation: pfFadeIn 0.18s ease-out;
  }
  #portfolio-lightbox[open] #pf-lightbox-img {
    animation: pfImgIn 0.25s ease-out;
  }
  #portfolio-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }
  @keyframes pfFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes pfImgIn {
    from {
      transform: scale(0.96);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
