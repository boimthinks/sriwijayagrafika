---
import type { CollectionEntry } from 'astro:content';
import { Calendar, BookOpen, ImageOff, PenTool, Newspaper, FileText, Megaphone, Lightbulb, Tag } from 'lucide-react';
import { TOPIK_LABELS } from '@lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: number;
}

const { post, readingTime } = Astro.props;
const data = post.data;
const href = `/blog/${data.topik}/${post.id}`;

const TOPIK_ICONS: Record<string, typeof Megaphone> = {
  'tips': Lightbulb,
  'studi-kasus': FileText,
  'panduan': BookOpen,
  'kabar': Megaphone,
};
const TopikIcon = TOPIK_ICONS[data.topik] ?? Tag;

const topikLabel = TOPIK_LABELS[data.topik] ?? data.topik;
const imgAlt = data.imgalt || data.titleSeo;
---

<a
  href={href}
  id={`blog-card-${post.id}`}
  class="group bg-white rounded-3xl border border-neutral-100 shadow-sm hover:shadow-md hover:border-neutral-200/80 flex flex-col transition-all duration-300 relative overflow-hidden"
  data-topik={data.topik}
>
  

  <div class="relative aspect-[16/9] w-full overflow-hidden bg-neutral-100">
    <img
      src={data.imgurl}
      alt={imgAlt}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-800 group-hover:scale-115"
    />
    <span class="absolute top-3 right-3 inline-flex items-center gap-1 px-2.5 py-1 text-[10px] font-bold text-white bg-[#224da8]/90 backdrop-blur rounded-md font-mono uppercase tracking-wide">
      <TopikIcon className="w-3 h-3" />
      {topikLabel}
    </span>
  </div>

  <div class="p-5 md:p-6 flex flex-col justify-between flex-1 gap-4">
    <div>
      <h3 class="text-base font-extrabold text-[#224da8] group-hover:text-[#ff6634] transition-colors leading-snug line-clamp-2">
        {data.title}
      </h3>
      <p class="text-xs text-neutral-500 mt-2.5 leading-relaxed line-clamp-3">
        {data.excerpt}
      </p>
    </div>

    <div class="pt-4 border-t border-dashed border-neutral-100 flex items-center justify-between text-[10px] font-mono uppercase tracking-wider text-neutral-400">
      <span class="flex items-center gap-1">
        <Calendar className="w-3 h-3" />
        {data.date}
      </span>
      <span class="flex items-center gap-1">
        <BookOpen className="w-3 h-3" />
        {readingTime} menit
      </span>
    </div>
  </div>
</a>
