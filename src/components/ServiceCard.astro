---
import type { CollectionEntry } from 'astro:content';
import { ArrowRight, ImageOff, Megaphone, ShieldAlert, FileText, Printer, BookOpen, Gift, Layout, Calendar, Sparkles, Package, MessageSquare, FileBadge, Tag, Boxes, Layers, PenTool } from 'lucide-react';

interface Props {
  service: CollectionEntry<'layanan'>;
  variant?: 'default' | 'compact';
}

const { service, variant = 'default' } = Astro.props;
const data = service.data;
const href = `/layanan/${service.id}`;

const SUBCATEGORY_ICONS: Record<string, typeof Megaphone> = {
  'Advertising & Reklame': Megaphone,
  'Rambu & Keamanan': ShieldAlert,
  'Acrylic Custom': Layers,
  'Event & Display': PenTool,
  'Percetakan Kantor': FileText,
  'Digital Printing': Printer,
  'Buku & Jilid': BookOpen,
  'Garmen & Souvenir': Gift,
  'Alat Peraga': Layout,
  'Acara & Seremoni': Calendar,
};
const PlaceholderIcon = SUBCATEGORY_ICONS[data.subcategory] ?? Boxes;

const CATEGORY_GRADIENTS: Record<string, string> = {
  utama: 'from-[#224da8] via-[#3c5a98] to-[#10285a]',
  secondary: 'from-[#ff6634] via-[#ff8a5e] to-[#c2410c]',
};
const gradient = CATEGORY_GRADIENTS[data.category] ?? 'from-neutral-700 to-neutral-900';

const SUBCAT_INITIALS = data.subcategory
  .split(/[\s&]+/)
  .filter((w) => w.length > 0)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? '')
  .join('');
---

<a
  href={href}
  id={`service-card-${service.id}`}
  class="group bg-white rounded-3xl border border-neutral-100 shadow-sm hover:shadow-md hover:border-neutral-200/80 flex flex-col transition-all duration-300 relative overflow-hidden"
  data-category={data.category}
  data-subcategory={data.subcategory}
>
  <span class="absolute top-0 left-0 w-1.5 h-full bg-[#ff6634] scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-top z-20" aria-hidden="true"></span>

  <div class="relative aspect-[16/10] w-full overflow-hidden bg-neutral-100">
    {data.imageUrl ? (
      <img
        src={data.imageUrl}
        alt={data.name}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div class={`w-full h-full bg-gradient-to-br ${gradient} flex items-center justify-center relative`}>
        <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 20px 20px;"></div>
        <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/10 blur-2xl"></div>
        <div class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full bg-white/5 blur-2xl"></div>

        <PlaceholderIcon className="w-16 h-16 text-white/40" strokeWidth={1.25} />

        <span class="absolute top-3 right-3 text-[9px] font-bold font-mono uppercase tracking-wider text-white/80 bg-white/15 backdrop-blur px-2 py-0.5 rounded-md">
          Placeholder
        </span>

        <span class="absolute bottom-3 left-3 text-[10px] font-mono font-extrabold tracking-wider text-white/70">
          {SUBCAT_INITIALS}
        </span>
      </div>
    )}
  </div>

  <div class={`p-5 md:p-6 flex flex-col justify-between flex-1 ${variant === 'compact' ? 'gap-3' : 'gap-0'}`}>
    <div>
      <div class="mb-4">
        <span class="px-2.5 py-1 text-[10px] font-bold text-[#224da8] bg-[#224da8]/5 rounded-md font-mono uppercase tracking-wide">
          {data.subcategory}
        </span>
      </div>

      <h3 class="text-base font-extrabold text-[#224da8] group-hover:text-[#ff6634] transition-colors leading-snug">
        {data.name}
      </h3>
      <p class="text-xs text-neutral-500 mt-2.5 leading-relaxed line-clamp-3">
        {data.description}
      </p>

      {data.features && data.features.length > 0 && (
        <div class="mt-4 pt-4 border-t border-dashed border-neutral-100 space-y-2">
          <span class="text-[10px] uppercase font-mono tracking-wider font-bold text-neutral-400">Keunggulan</span>
          <div class="space-y-1 text-xs">
            {data.features.slice(0, 3).map((feat) => (
              <div class="flex items-start gap-1.5 text-neutral-600 font-medium">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span class="line-clamp-1">{feat}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between gap-2">
      <div>
        <span class="block text-[10px] text-neutral-400 leading-none">Mulai dari</span>
        <span class="block text-sm font-extrabold text-neutral-800 font-mono mt-0.5">
          Rp {data.basePrice.toLocaleString('id-ID')}
          <span class="text-[10px] text-neutral-400 font-normal"> / {data.priceUnit}</span>
        </span>
      </div>

      <span class="px-3 py-2 bg-[#224da8]/5 group-hover:bg-[#224da8] text-[#224da8] group-hover:text-white text-[11px] font-bold rounded-xl flex items-center gap-1.5 transition-all">
        <span>Detail</span>
        <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
      </span>
    </div>
  </div>
</a>
