---
import { ShieldCheck, Clock, Award } from 'lucide-react';

const credentials = [
  {
    icon: Award,
    color: 'orange',
    title: 'Garansi Resmi 1 Tahun',
    description:
      'Komitmen jaminan kualitas tepercaya untuk mengasuransikan lampu LED dan struktur terhadap tiupan angin serta kerusakan cuaca Palembang.',
  },
  {
    icon: Clock,
    color: 'blue',
    title: '16 Tahun Pengalaman Jasa',
    description:
      'Selesai membidangi ratusan proyek reklame, huruf 3D timbul stainless, plang toko kemitraan, canva, dan stempel kilat.',
  },
  {
    icon: ShieldCheck,
    color: 'emerald',
    title: 'Hasil Penawaran Transparan',
    description:
      'Tidak ada biaya tersembunyi. Gunakan kalkulator kami untuk merancang huruf LED/neon box dengan spesifikasi kustom, lalu kumpulkan langsung via WhatsApp.',
  },
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 lg:py-16" id="credentials">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {credentials.map(({ icon: Icon, color, title, description }) => (
      <div class="p-6 bg-white border border-neutral-100 rounded-3xl flex items-start gap-4">
        <div class:list={[
          'p-3 rounded-2xl flex-shrink-0',
          color === 'orange' ? 'bg-orange-50 text-[#ff6634]' : '',
          color === 'blue' ? 'bg-blue-50 text-[#224da8]' : '',
          color === 'emerald' ? 'bg-emerald-50 text-emerald-600' : '',
        ]}>
          <Icon className="w-6 h-6" />
        </div>
        <div class="space-y-1">
          <h3 class="text-sm font-extrabold text-[#224da8]">{title}</h3>
          <p class="text-xs text-neutral-500 font-normal leading-relaxed">{description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
