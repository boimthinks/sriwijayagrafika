---
import { Phone, Menu, X, ShieldCheck } from 'lucide-react';
import { BUSINESS_INFO } from '@lib/data';

interface Props {
   current?: 'home' | 'services' | 'portfolio' | 'blog' | 'contact';
 }

const { current = 'home' } = Astro.props;

const menuItems = [
   { id: 'home', label: 'Beranda', href: '/' },
   { id: 'services', label: 'Layanan', href: '/layanan' },
   { id: 'portfolio', label: 'Galeri Portofolio', href: '/portofolio' },
    { id: 'blog', label: 'Blog', href: '/blog' },
    { id: 'contact', label: 'Kontak', href: '/kontak' },
  ] as const;

const isActive = (id: string) => current === id;
---

<nav class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-neutral-100 shadow-sm" id="main-nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20">
      <!-- Logo Section -->
      <a href="/" class="flex-shrink-0 flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 1073 935"
          class="w-10 h-10 flex-shrink-0"
          id="brand-logo-svg"
          aria-label="Sriwijaya Grafika logo"
        >
          <path fill-rule="evenodd" fill="rgb(255, 102, 52)"
            d="M1040.1,662 C1030.5,679 1016.4,702.4 1009,709.1 L1008.1,858.1 C1008.1,901 974.97,935 932.1,935 L138,935 C96.03,935 62,901 62,858.1 L62,823.4 C56.06,821 44.36,816.4 33,812 C16.63,805.7 0,797 0,797 L58,711 L26,783 L62,796.7 L62,796.55 C108.33,814.29 201.25,843.34 336,854.1 C433.43,863.43 615.86,856.02 757,810 C886.95,768.25 984.28,697.64 1008.92,678.77 C1015.96,671.16 1029.45,656.19 1041,640 C1058.4,618.85 1072,594.1 1072,594.1 C1072,594.1 1060.09,631.01 1040.1,662 ZM574.1,746.1 C370.56,780.02 108,662 108,662 L62,731 L62,450.19 C81.63,477.86 137.73,536.54 224,549 C341.63,565.99 416,547.1 416,547.1 L677,500.1 C677,500.1 869.29,458.16 914.1,527.1 C960.71,597.84 779.44,713.98 574.1,746.1 Z" />
          <path fill-rule="evenodd" fill="rgb(34, 77, 168)"
            d="M886,437 C806.09,423.17 698.1,434 698.1,434 C698.1,434 755.05,413.69 799,387 C835.94,364.56 861.1,335 861.1,335 L749.1,242 C749.1,242 766.51,316.55 657.1,360 C518.54,415.84 240.15,422.54 219.1,337 C178.76,161.93 689.1,125.1 689.1,125.1 C689.1,125.1 461.19,111.26 259,172.1 C153.1,205.34 79.47,281.16 61.1,300.46 L61.1,75.1 C61.1,34.03 96.03,0 138,0 L932.1,0 C974.97,0 1009,34.03 1009,75.1 L1009,486.53 C999.15,479.47 953.11,448.62 886,437 Z" />
        </svg>
        <div>
          <span class="block text-lg font-bold tracking-tight text-[#224da8]">
            SRIWIJAYA <span class="text-[#c2410c]">GRAFIKA</span>
          </span>
          <span class="hidden md:block text-[10px] font-mono tracking-wider text-neutral-600 font-bold">
            Spesialis Signage &amp; Advertising di Palembang
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        {menuItems.map((item) => (
          <a
            href={item.href}
            id={`nav-${item.id}`}
            class:list={[
              'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200',
              isActive(item.id)
                ? 'text-[#224da8] bg-[#224da8]/5'
                : 'text-neutral-600 hover:text-[#224da8] hover:bg-neutral-50',
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Contact Actions -->
      <div class="hidden md:flex items-center gap-3">
        
        <a
          href={`https://wa.me/${BUSINESS_INFO.phone1Intl}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#224da8] hover:bg-[#183c84] text-white text-sm font-semibold shadow-md transition-all duration-200"
          id="cta-whatsapp-nav"
        >
          <Phone className="w-4 h-4 fill-white" />
          <span>WhatsApp</span>
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-neutral-500 hover:text-[#224da8] hover:bg-neutral-100"
        aria-controls="mobile-menu-dialog"
        aria-expanded="false"
      >
        <span class="sr-only">Buka menu</span>
        <Menu className="w-6 h-6" id="mobile-menu-icon-open" />
        <X className="w-6 h-6 hidden" id="mobile-menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="md:hidden hidden border-t border-neutral-100 bg-white shadow-lg" id="mobile-menu-dialog">
    <div class="px-2 pt-2 pb-4 space-y-1">
      {menuItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block w-full px-4 py-3 rounded-lg text-base font-medium',
            isActive(item.id)
              ? 'text-[#224da8] bg-[#224da8]/5 font-semibold'
              : 'text-neutral-600 hover:text-[#224da8] hover:bg-neutral-50',
          ]}
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4 pb-2 border-t border-neutral-100 px-4 space-y-3">
          <a
          href={`https://wa.me/${BUSINESS_INFO.phone1Intl}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-3 rounded-lg bg-[#224da8] hover:bg-[#183c84] text-white text-sm font-semibold shadow-md"
        >
          <Phone className="w-4 h-4" />
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const dialog = document.getElementById('mobile-menu-dialog');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  if (btn && dialog && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isOpen = !dialog.classList.contains('hidden');
      if (isOpen) {
        dialog.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        dialog.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>
