---
import { ShieldCheck, Award, Users, ArrowRight, Sparkles } from 'lucide-react';
import { SITE_SETTINGS } from '@lib/site';

const { hero } = SITE_SETTINGS;

function formatHeroTitle(title: string): string {
  if (title.includes('<span') || title.includes('<strong')) {
    return title;
  }
  // Auto-highlight Sriwijaya Grafika jika ada
  return title
    .replace('Sriwijaya', '<span class="text-[#224da8]">Sriwijaya</span>')
    .replace('Grafika', '<span class="text-[#ff6634]">Grafika</span>');
}

const formattedTitle = formatHeroTitle(hero.title);
---

<section class="relative overflow-hidden pt-10 pb-20 md:py-24" id="hero-section">
  <div class="absolute inset-0 -z-20">
    <picture>
      <source media="(max-width: 767px)" srcset={hero.imageMobile} />
      <source media="(min-width: 768px)" srcset={hero.imageDesktop} />
      <img
        src={hero.imageDesktop}
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        class="w-full h-full object-cover"
      />
    </picture>
  </div>

  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-white/95 via-white/80 to-transparent lg:bg-gradient-to-r lg:from-white/95 lg:via-white/80 lg:to-transparent"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        {hero.badge && (
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#224da8]/10 text-[#224da8] text-xs font-semibold tracking-wide">
            <Sparkles className="w-3.5 h-3.5 text-[#ff6634] fill-[#ff6634]" />
            <span>{hero.badge}</span>
          </div>
        )}

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-neutral-900 leading-[1.1]" id="hero-title" set:html={formattedTitle} />

        <p class="text-base sm:text-lg text-neutral-600 leading-relaxed font-normal max-w-2xl mx-auto lg:mx-0">
          {hero.subtitle}
        </p>

        {hero.stats && hero.stats.length > 0 && (
          <div class="grid grid-cols-3 gap-2 py-2 text-center max-w-md mx-auto lg:mx-0">
            {hero.stats.map((stat, idx) => {
              const colors = ['text-[#224da8]', 'text-[#c2410c]', 'text-indigo-700'];
              const color = colors[idx % colors.length];
              return (
                <div class="border border-neutral-100 rounded-xl bg-white p-3 shadow-sm">
                  <span class={`block text-xl font-extrabold ${color}`}>{stat.value}</span>
                  <span class="block text-[10px] font-mono tracking-wider text-neutral-600 uppercase">
                    {stat.label}
                  </span>
                </div>
              );
            })}
          </div>
        )}

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href={hero.ctaUrl || '/kontak'}
            class="w-full sm:w-auto flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#224da8] hover:bg-[#183c84] text-white font-bold text-base shadow-lg shadow-[#224da8]/20 transition-all duration-200 group"
            id="btn-explore-services"
          >
            <span>{hero.ctaText || 'Hubungi Kami'}</span>
            <ArrowRight className="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" />
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 relative"></div>
    </div>
  </div>
</section>
